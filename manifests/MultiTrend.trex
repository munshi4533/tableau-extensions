<?xml version="1.0" encoding="utf-8"?>
<!-- GENERATED by tools/build.py from extensions/multi-trend/extension.json. Do not edit by hand. -->
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.munshi.tableau.multitrend" extension-version="1.0.3">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Several measures over time on one chart. Each measure can be a solid, dashed or dotted line, an area or bars, with its own color and axis, plus a tooltip comparing them.</description>
    <author name="Munshi Muntasir Islam" email="mmuislam.munshi@gmail.com" organization="CareFlo" website="https://www.linkedin.com/in/muntasir-analyst-bd/"/>
    <min-api-version>1.11</min-api-version>
    <source-location>
      <url>https://munshi4533.github.io/tableau-extensions/extensions/multi-trend/</url>
    </source-location>
    <icon></icon>
    <permissions>
      <permission>full data</permission>
    </permissions>
    <!-- Adds the "Format Extension" button (calls the configure callback) -->
    <context-menu>
      <configure-context-menu-item />
    </context-menu>
    <encoding id="date">
      <display-name resource-id="date-name">Date</display-name>
      <role-spec>
        <role-type>continuous-dimension</role-type>
        <role-type>discrete-dimension</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="letter-x"/>
      <tooltip resource-id="date-tooltip">A date or period: MONTH(Date), DAY(Date), or a discrete period. Every measure is plotted against it.</tooltip>
    </encoding>
    <encoding id="measures">
      <display-name resource-id="measures-name">Measures</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="10"/>
      <encoding-icon token="metric"/>
      <tooltip resource-id="measures-tooltip">One or more measures or calculations, each becomes its own line, area or bars. Style each one in Format Extension → Measures.</tooltip>
    </encoding>
  </worksheet-extension>
  <resources>
    <resource id="name"><text locale="en_US">Multi Measure Trend</text></resource>
    <resource id="date-name"><text locale="en_US">Date</text></resource>
    <resource id="date-tooltip"><text locale="en_US">A date or period: MONTH(Date), DAY(Date), or a discrete period. Every measure is plotted against it.</text></resource>
    <resource id="measures-name"><text locale="en_US">Measures</text></resource>
    <resource id="measures-tooltip"><text locale="en_US">One or more measures or calculations, each becomes its own line, area or bars. Style each one in Format Extension → Measures.</text></resource>
  </resources>
</manifest>
