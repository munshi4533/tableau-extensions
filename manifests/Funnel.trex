<?xml version="1.0" encoding="utf-8"?>
<!-- GENERATED by tools/build.py from extensions/funnel/extension.json. Do not edit by hand. -->
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.munshi.tableau.funnel" extension-version="1.1.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Conversion funnel from the measures on the Stages shelf (e.g. Started → Submitted → Approved → Disbursed): one box per stage with % of start and % of previous stage, the drop between stages, overall conversion and the weakest step.</description>
    <author name="Munshi Muntasir Islam" email="mmuislam.munshi@gmail.com" organization="CareFlo" website="https://www.linkedin.com/in/muntasir-analyst-bd/"/>
    <min-api-version>1.11</min-api-version>
    <source-location>
      <url>https://munshi4533.github.io/tableau-extensions/extensions/funnel/</url>
    </source-location>
    <icon></icon>
    <permissions>
      <permission>full data</permission>
    </permissions>
    <!-- Adds the "Format Extension" button (calls the configure callback) -->
    <context-menu>
      <configure-context-menu-item />
    </context-menu>
    <encoding id="stages">
      <display-name resource-id="stages-name">Stages</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="10"/>
      <encoding-icon token="metric"/>
      <tooltip resource-id="stages-tooltip">One measure per stage, in funnel order (e.g. COUNTD(Started), COUNTD(Submitted), COUNTD(Approved), COUNTD(Disbursed)). Drag to reorder; rename and recolor in Format Extension.</tooltip>
    </encoding>
  </worksheet-extension>
  <resources>
    <resource id="name"><text locale="en_US">Funnel</text></resource>
    <resource id="stages-name"><text locale="en_US">Stages</text></resource>
    <resource id="stages-tooltip"><text locale="en_US">One measure per stage, in funnel order (e.g. COUNTD(Started), COUNTD(Submitted), COUNTD(Approved), COUNTD(Disbursed)). Drag to reorder; rename and recolor in Format Extension.</text></resource>
  </resources>
</manifest>
