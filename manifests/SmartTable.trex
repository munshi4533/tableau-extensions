<?xml version="1.0" encoding="utf-8"?>
<!-- GENERATED by tools/build.py from extensions/smart-table/extension.json. Do not edit by hand. -->
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.munshi.tableau.smarttable" extension-version="1.2.1">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Fast flat table for large data (virtual scrolling): sort and filter any column, search, conditional colors, totals, and row selection that drives dashboard actions.</description>
    <author name="Munshi Muntasir Islam" email="mmuislam.munshi@gmail.com" organization="CareFlo" website="https://www.linkedin.com/in/muntasir-analyst-bd/"/>
    <min-api-version>1.11</min-api-version>
    <source-location>
      <url>https://munshi4533.github.io/tableau-extensions/extensions/smart-table/</url>
    </source-location>
    <icon></icon>
    <permissions>
      <permission>full data</permission>
    </permissions>
    <!-- Adds the "Format Extension" button (calls the configure callback) -->
    <context-menu>
      <configure-context-menu-item />
    </context-menu>
    <encoding id="fields">
      <display-name resource-id="fields-name">Fields</display-name>
      <fields max-count="60"/>
      <encoding-icon token="grid"/>
      <tooltip resource-id="fields-tooltip">Every field you want as a column, in the order you want them. Dimensions and measures both work. Fields on Detail are not shown but can drive colors and actions.</tooltip>
    </encoding>
  </worksheet-extension>
  <resources>
    <resource id="name"><text locale="en_US">Smart Table</text></resource>
    <resource id="fields-name"><text locale="en_US">Fields</text></resource>
    <resource id="fields-tooltip"><text locale="en_US">Every field you want as a column, in the order you want them. Dimensions and measures both work. Fields on Detail are not shown but can drive colors and actions.</text></resource>
  </resources>
</manifest>
