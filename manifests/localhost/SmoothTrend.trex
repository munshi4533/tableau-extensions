<?xml version="1.0" encoding="utf-8"?>
<!-- GENERATED by tools/build.py from extensions/smooth-trend/extension.json. Do not edit by hand. -->
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.munshi.tableau.smoothtrend.dev" extension-version="1.3.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Smooth line trend with a KPI header (latest, MTD, QTD, YTD or your own calculation), growth/degrowth coloring and smart tooltips.</description>
    <author name="Munshi Muntasir Islam" email="mmuislam.munshi@gmail.com" organization="CareFlo" website="https://www.linkedin.com/in/muntasir-analyst-bd/"/>
    <min-api-version>1.11</min-api-version>
    <source-location>
      <url>http://localhost:8765/extensions/smooth-trend/index.html</url>
    </source-location>
    <icon></icon>
    <permissions>
      <permission>full data</permission>
    </permissions>
    <!-- Adds the "Format Extension" button (calls the configure callback) -->
    <context-menu>
      <configure-context-menu-item />
    </context-menu>
    <encoding id="date">
      <display-name resource-id="date-name">Date</display-name>
      <role-spec>
        <role-type>continuous-dimension</role-type>
        <role-type>discrete-dimension</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="letter-x"/>
      <tooltip resource-id="date-tooltip">A date or period. Continuous MONTH(Date) works best; discrete periods like Q1 2025 also work. MTD/QTD/YTD need a real date.</tooltip>
    </encoding>
    <encoding id="value">
      <display-name resource-id="value-name">Value</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="letter-y"/>
      <tooltip resource-id="value-tooltip">The measure to trend, e.g. SUM(Sales).</tooltip>
    </encoding>
    <encoding id="series">
      <display-name resource-id="series-name">Series</display-name>
      <role-spec>
        <role-type>discrete-dimension</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="color"/>
      <tooltip resource-id="series-tooltip">Optional. A dimension that splits the trend into several lines (up to 8; the rest are grouped as Other).</tooltip>
    </encoding>
    <encoding id="kpi">
      <display-name resource-id="kpi-name">KPI</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="2"/>
      <encoding-icon token="metric"/>
      <tooltip resource-id="kpi-tooltip">Optional. Your own calculation for the header number (e.g. MTD Sales). Add a second measure to compare against it (e.g. Last Month Sales). Its value at the latest date is used.</tooltip>
    </encoding>
  </worksheet-extension>
  <resources>
    <resource id="name"><text locale="en_US">Smooth Trend (dev)</text></resource>
    <resource id="date-name"><text locale="en_US">Date</text></resource>
    <resource id="date-tooltip"><text locale="en_US">A date or period. Continuous MONTH(Date) works best; discrete periods like Q1 2025 also work. MTD/QTD/YTD need a real date.</text></resource>
    <resource id="value-name"><text locale="en_US">Value</text></resource>
    <resource id="value-tooltip"><text locale="en_US">The measure to trend, e.g. SUM(Sales).</text></resource>
    <resource id="series-name"><text locale="en_US">Series</text></resource>
    <resource id="series-tooltip"><text locale="en_US">Optional. A dimension that splits the trend into several lines (up to 8; the rest are grouped as Other).</text></resource>
    <resource id="kpi-name"><text locale="en_US">KPI</text></resource>
    <resource id="kpi-tooltip"><text locale="en_US">Optional. Your own calculation for the header number (e.g. MTD Sales). Add a second measure to compare against it (e.g. Last Month Sales). Its value at the latest date is used.</text></resource>
  </resources>
</manifest>
