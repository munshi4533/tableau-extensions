<?xml version="1.0" encoding="utf-8"?>
<!-- GENERATED by tools/build.py from extensions/kpi-card/extension.json. Do not edit by hand. -->
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.munshi.tableau.kpicard.dev" extension-version="1.4.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>A row of KPI cards from a plain date and your measures: MTD, last month or last day as the big number, worked out in the extension. Calculated KPIs (e.g. Average Loan Size = Loan Amount / Loans) are rolled up correctly for each period. Comparison, secondary values, target progress, and a chart per card: mini trend, daily bars + running total, bars, line or running total.</description>
    <author name="Munshi Muntasir Islam" email="mmuislam.munshi@gmail.com" organization="CareFlo" website="https://www.linkedin.com/in/muntasir-analyst-bd/"/>
    <min-api-version>1.11</min-api-version>
    <source-location>
      <url>http://localhost:8765/extensions/kpi-card/</url>
    </source-location>
    <icon></icon>
    <permissions>
      <permission>full data</permission>
    </permissions>
    <!-- Adds the "Format Extension" button (calls the configure callback) -->
    <context-menu>
      <configure-context-menu-item />
    </context-menu>
    <encoding id="date">
      <display-name resource-id="date-name">Date</display-name>
      <role-spec>
        <role-type>continuous-dimension</role-type>
        <role-type>discrete-dimension</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="letter-x"/>
      <tooltip resource-id="date-tooltip">A plain date at DAY level, e.g. DAY(Disbursement Date) or an exact date. MTD, last month and last day are calculated from it.</tooltip>
    </encoding>
    <encoding id="measures">
      <display-name resource-id="measures-name">Measures</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="20"/>
      <encoding-icon token="metric"/>
      <tooltip resource-id="measures-tooltip">Your basic measures, e.g. SUM(Loan Amount), COUNT(Loans), SUM(Balance). One card each; build ratios like Average Loan Size in Format Extension → Calculated KPI.</tooltip>
    </encoding>
  </worksheet-extension>
  <resources>
    <resource id="name"><text locale="en_US">KPI Card (dev)</text></resource>
    <resource id="date-name"><text locale="en_US">Date</text></resource>
    <resource id="date-tooltip"><text locale="en_US">A plain date at DAY level, e.g. DAY(Disbursement Date) or an exact date. MTD, last month and last day are calculated from it.</text></resource>
    <resource id="measures-name"><text locale="en_US">Measures</text></resource>
    <resource id="measures-tooltip"><text locale="en_US">Your basic measures, e.g. SUM(Loan Amount), COUNT(Loans), SUM(Balance). One card each; build ratios like Average Loan Size in Format Extension → Calculated KPI.</text></resource>
  </resources>
</manifest>
