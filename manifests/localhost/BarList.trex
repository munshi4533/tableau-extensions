<?xml version="1.0" encoding="utf-8"?>
<!-- GENERATED by tools/build.py from extensions/bar-list/extension.json. Do not edit by hand. -->
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.munshi.tableau.barlist.dev" extension-version="1.0.2">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Ranked bars for a dimension: value and % of total, Top N + Others, several KPIs with switch buttons (incl. calculated ones), optional breakdown and target, thin to thick and square to round bars.</description>
    <author name="Munshi Muntasir Islam" email="mmuislam.munshi@gmail.com" organization="CareFlo" website="https://www.linkedin.com/in/muntasir-analyst-bd/"/>
    <min-api-version>1.11</min-api-version>
    <source-location>
      <url>http://localhost:8765/extensions/bar-list/</url>
    </source-location>
    <icon></icon>
    <permissions>
      <permission>full data</permission>
    </permissions>
    <!-- Adds the "Format Extension" button (calls the configure callback) -->
    <context-menu>
      <configure-context-menu-item />
    </context-menu>
    <encoding id="category">
      <display-name resource-id="category-name">Category</display-name>
      <role-spec>
        <role-type>discrete-dimension</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="letter-y"/>
      <tooltip resource-id="category-tooltip">The dimension: one bar per value (e.g. Salary Bucket).</tooltip>
    </encoding>
    <encoding id="measures">
      <display-name resource-id="measures-name">Measures</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="10"/>
      <encoding-icon token="metric"/>
      <tooltip resource-id="measures-tooltip">One or more KPIs (e.g. COUNT(Customers), SUM(Loan Amount)). With several, viewers switch between them with buttons. Calculated KPIs: Format Extension.</tooltip>
    </encoding>
    <encoding id="breakdown">
      <display-name resource-id="breakdown-name">Breakdown</display-name>
      <role-spec>
        <role-type>discrete-dimension</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="color"/>
      <tooltip resource-id="breakdown-tooltip">Optional. A second dimension that splits every bar into colored segments.</tooltip>
    </encoding>
    <encoding id="target">
      <display-name resource-id="target-name">Target</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="1"/>
      <tooltip resource-id="target-tooltip">Optional. A target per bar: shown as a marker, and bars can fill up to it.</tooltip>
    </encoding>
  </worksheet-extension>
  <resources>
    <resource id="name"><text locale="en_US">Bar List (dev)</text></resource>
    <resource id="category-name"><text locale="en_US">Category</text></resource>
    <resource id="category-tooltip"><text locale="en_US">The dimension: one bar per value (e.g. Salary Bucket).</text></resource>
    <resource id="measures-name"><text locale="en_US">Measures</text></resource>
    <resource id="measures-tooltip"><text locale="en_US">One or more KPIs (e.g. COUNT(Customers), SUM(Loan Amount)). With several, viewers switch between them with buttons. Calculated KPIs: Format Extension.</text></resource>
    <resource id="breakdown-name"><text locale="en_US">Breakdown</text></resource>
    <resource id="breakdown-tooltip"><text locale="en_US">Optional. A second dimension that splits every bar into colored segments.</text></resource>
    <resource id="target-name"><text locale="en_US">Target</text></resource>
    <resource id="target-tooltip"><text locale="en_US">Optional. A target per bar: shown as a marker, and bars can fill up to it.</text></resource>
  </resources>
</manifest>
