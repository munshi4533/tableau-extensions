<?xml version="1.0" encoding="utf-8"?>
<!-- GENERATED by tools/build.py from extensions/stage-flow/extension.json. Do not edit by hand. -->
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.munshi.tableau.stageflow" extension-version="1.2.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Where applications go: a flow through ordered stages (e.g. Responsible lending → … → Disbursed) where what leaves at each stage peels off, split by outcome (Rejected / Cancelled / In progress) with the reasons on hover; after the last stage, kept vs cancelled.</description>
    <author name="Munshi Muntasir Islam" email="mmuislam.munshi@gmail.com" organization="CareFlo" website="https://www.linkedin.com/in/muntasir-analyst-bd/"/>
    <min-api-version>1.11</min-api-version>
    <source-location>
      <url>https://munshi4533.github.io/tableau-extensions/extensions/stage-flow/</url>
    </source-location>
    <icon></icon>
    <permissions>
      <permission>full data</permission>
    </permissions>
    <!-- Adds the "Format Extension" button (calls the configure callback) -->
    <context-menu>
      <configure-context-menu-item />
    </context-menu>
    <encoding id="stage">
      <display-name resource-id="stage-name">Stage</display-name>
      <role-spec>
        <role-type>discrete-dimension</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="letter-x"/>
      <tooltip resource-id="stage-tooltip">The furthest stage each application reached (one row per application in your data). Order: Format Extension, or a rank field (e.g. MIN(furthest_rank)) on Detail.</tooltip>
    </encoding>
    <encoding id="outcome">
      <display-name resource-id="outcome-name">Outcome</display-name>
      <role-spec>
        <role-type>discrete-dimension</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="color"/>
      <tooltip resource-id="outcome-tooltip">How it ended, e.g. Disbursed / Rejected / Cancelled / In progress / Cancelled after disbursement.</tooltip>
    </encoding>
    <encoding id="count">
      <display-name resource-id="count-name">Count</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="metric"/>
      <tooltip resource-id="count-tooltip">How many, e.g. COUNTD(id).</tooltip>
    </encoding>
    <encoding id="reason">
      <display-name resource-id="reason-name">Reason</display-name>
      <role-spec>
        <role-type>discrete-dimension</role-type>
      </role-spec>
      <fields max-count="2"/>
      <tooltip resource-id="reason-tooltip">Optional. Reason and sub reason (e.g. reject_reason, reject_sub_reason): shown on hover over a leak.</tooltip>
    </encoding>
  </worksheet-extension>
  <resources>
    <resource id="name"><text locale="en_US">Stage Flow</text></resource>
    <resource id="stage-name"><text locale="en_US">Stage</text></resource>
    <resource id="stage-tooltip"><text locale="en_US">The furthest stage each application reached (one row per application in your data). Order: Format Extension, or a rank field (e.g. MIN(furthest_rank)) on Detail.</text></resource>
    <resource id="outcome-name"><text locale="en_US">Outcome</text></resource>
    <resource id="outcome-tooltip"><text locale="en_US">How it ended, e.g. Disbursed / Rejected / Cancelled / In progress / Cancelled after disbursement.</text></resource>
    <resource id="count-name"><text locale="en_US">Count</text></resource>
    <resource id="count-tooltip"><text locale="en_US">How many, e.g. COUNTD(id).</text></resource>
    <resource id="reason-name"><text locale="en_US">Reason</text></resource>
    <resource id="reason-tooltip"><text locale="en_US">Optional. Reason and sub reason (e.g. reject_reason, reject_sub_reason): shown on hover over a leak.</text></resource>
  </resources>
</manifest>
